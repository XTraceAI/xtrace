  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "22.18.6",
    "typescript": "5.9.3"
  }
}
