{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XTrace",
  "version": "0.1.8",
  "identifier": "ai.xtrace.app",
  "build": {
    "beforeDevCommand": "pnpm --dir ui dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm --dir ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "XTrace",
        "width": 1440,
        "height": 900,
        "minWidth": 1120,
        "minHeight": 720,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 26 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["../ui/public/icons/icon.png", "../ui/public/icons/icon.icns"],
    "resources": {
      "../../../vendor/agent-plugins": "agent-plugins",
      "../../../vendor/claude-md-doctor/skill": "grading-skills/claude-md-doctor/skill",
      "../../../vendor/claude-md-doctor/LICENSE": "grading-skills/claude-md-doctor/LICENSE",
      "../../../crates/xt-judge/rubric-maker": "grading-skills/xtrace-rubric-maker"
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "dmg": {
        "background": "dmg/background.tiff",
        "windowSize": { "width": 660, "height": 432 },
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 }
      }
    }
  }
}
